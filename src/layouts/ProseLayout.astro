---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  backHref?: string;
  backLabel?: string;
  /** Case studies hide the back-link/back-to-top chrome — Home-return and
   * back-to-top are both handled by sitewide UI (the header and the
   * floating corner button). Blog keeps them. Default: true. */
  showBackLinks?: boolean;
  prevHref?: string;
  prevLabel?: string;
  nextHref?: string;
  nextLabel?: string;
}

const {
  title,
  description,
  ogImage,
  backHref,
  backLabel,
  showBackLinks = true,
  prevHref,
  prevLabel,
  nextHref,
  nextLabel,
} = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <div class="px-6 pt-16 pb-8 md:pt-24 md:pb-10" id="prose-top" tabindex="-1">
    <div class="mx-auto" style="max-width: 68ch;">

      <Header />

      <!-- Back link -->
      {showBackLinks && (
        <a
          href={backHref}
          class="meta-label mt-16 mb-16 back-link tap-target"
          style="color: var(--text-muted);"
        >
          <span aria-hidden="true">←</span> {backLabel}
        </a>
      )}

      <!-- Content -->
      <article class:list={['prose-content', { 'mt-10 md:mt-12': !showBackLinks }]}>
        <slot />
      </article>

      <!-- Prev / Next -->
      {(prevHref || nextHref) && (
        <nav
          class="mt-28 flex justify-between gap-8"
          aria-label="Case study navigation"
        >
          {prevHref ? (
            <a href={prevHref} class="prev-next-link text-left tap-target" style="max-width: 45%;">
              <span class="meta-label block mb-1">← Previous</span>
              <span class="prev-next-title text-sm font-medium" style="color: var(--text);">{prevLabel}</span>
            </a>
          ) : <span />}
          {nextHref && (
            <a href={nextHref} class="prev-next-link text-right ml-auto tap-target" style="max-width: 45%;">
              <span class="meta-label block mb-1">Next →</span>
              <span class="prev-next-title text-sm font-medium" style="color: var(--text);">{nextLabel}</span>
            </a>
          )}
        </nav>
      )}

      <!-- Back to projects / back to top -->
      {showBackLinks && (
        <div class="mt-16 flex items-center justify-between gap-8">
          <a
            href={backHref}
            class="meta-label back-link tap-target"
            style="color: var(--text-muted);"
          >
            <span aria-hidden="true">←</span> {backLabel}
          </a>
          <a
            href="#prose-top"
            class="meta-label back-link tap-target"
            style="color: var(--text-muted);"
          >
            Back to top <span aria-hidden="true">↑</span>
          </a>
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  /* Focus lands here after "Back to top" so keyboard focus stays in sync
     with the scroll position — not a control itself, so no visible ring. */
  #prose-top:focus-visible {
    outline: none;
  }

  .back-link {
    display: inline-block;
    text-decoration: none;
    transition: color 150ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .back-link:hover {
      color: var(--text);
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    .prev-next-link:hover .prev-next-title {
      text-decoration: underline;
      text-underline-offset: 2px;
    }
  }

  .prose-content :global(h1) {
    font-size: 2rem;
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: 0.5rem;
    color: var(--text);
  }
  .prose-content :global(h2) {
    font-size: 1.125rem;
    font-weight: 600;
    margin-top: 4.5rem;
    margin-bottom: 1rem;
    color: var(--text);
  }
  .prose-content :global(h3) {
    font-size: 1rem;
    font-weight: 500;
    margin-top: 3rem;
    margin-bottom: 0.5rem;
    color: var(--text);
  }
  .prose-content :global(p) {
    margin-bottom: 1.7rem;
    color: var(--text);
  }
  .prose-content :global(img) {
    width: 100%;
    border-radius: var(--radius-media);
    margin: 3.5rem 0;
  }
  .prose-content :global(a) {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-content :global(ul),
  .prose-content :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.7rem;
  }
  .prose-content :global(li) {
    margin-bottom: 0.4rem;
  }
  .prose-content :global(blockquote) {
    border-left: 2px solid var(--text);
    padding-left: 1.25rem;
    margin: 3rem 0;
    font-style: normal;
    font-weight: 500;
  }
  .prose-content :global(code) {
    font-family: var(--font-sans);
    font-size: 0.875em;
  }
</style>
