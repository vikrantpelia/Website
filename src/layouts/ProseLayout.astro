---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  backHref: string;
  backLabel: string;
  prevHref?: string;
  prevLabel?: string;
  nextHref?: string;
  nextLabel?: string;
}

const {
  title,
  description,
  ogImage,
  backHref,
  backLabel,
  prevHref,
  prevLabel,
  nextHref,
  nextLabel,
} = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <div class="px-6 py-16 md:py-24" id="prose-top">
    <div class="mx-auto" style="max-width: 68ch;">

      <!-- Back link -->
      <a
        href={backHref}
        class="meta-label mb-12 back-link tap-target"
        style="color: var(--text-muted);"
      >
        <span aria-hidden="true">←</span> {backLabel}
      </a>

      <!-- Content -->
      <article class="prose-content">
        <slot />
      </article>

      <!-- Prev / Next -->
      {(prevHref || nextHref) && (
        <nav
          class="mt-20 pt-8 hairline flex justify-between gap-8"
          aria-label="Case study navigation"
        >
          {prevHref ? (
            <a href={prevHref} class="prev-next-link text-left tap-target" style="max-width: 45%;">
              <span class="meta-label block mb-1">← Previous</span>
              <span class="prev-next-title text-sm font-medium" style="color: var(--text);">{prevLabel}</span>
            </a>
          ) : <span />}
          {nextHref && (
            <a href={nextHref} class="prev-next-link text-right ml-auto tap-target" style="max-width: 45%;">
              <span class="meta-label block mb-1">Next →</span>
              <span class="prev-next-title text-sm font-medium" style="color: var(--text);">{nextLabel}</span>
            </a>
          )}
        </nav>
      )}

      <!-- Back to projects / back to top -->
      <div class="mt-12 flex items-center justify-between gap-8">
        <a
          href={backHref}
          class="meta-label back-link tap-target"
          style="color: var(--text-muted);"
        >
          ← {backLabel}
        </a>
        <a
          href="#prose-top"
          class="meta-label back-link tap-target"
          style="color: var(--text-muted);"
        >
          Back to top ↑
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    text-decoration: none;
    transition: color 150ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .back-link:hover {
      color: var(--text);
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    .prev-next-link:hover .prev-next-title {
      text-decoration: underline;
      text-underline-offset: 2px;
    }
  }

  .prose-content :global(h1) {
    font-size: 2rem;
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: 0.5rem;
    color: var(--text);
  }
  .prose-content :global(h2) {
    font-size: 1.125rem;
    font-weight: 600;
    margin-top: 3rem;
    margin-bottom: 0.75rem;
    color: var(--text);
  }
  .prose-content :global(h3) {
    font-size: 1rem;
    font-weight: 500;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    color: var(--text);
  }
  .prose-content :global(p) {
    margin-bottom: 1.5rem;
    color: var(--text);
  }
  .prose-content :global(img) {
    width: 100%;
    border-radius: 4px;
    margin: 2.5rem 0;
  }
  .prose-content :global(a) {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-content :global(ul),
  .prose-content :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .prose-content :global(li) {
    margin-bottom: 0.4rem;
  }
  .prose-content :global(blockquote) {
    border-left: 2px solid var(--text);
    padding-left: 1.25rem;
    margin: 2rem 0;
    font-style: normal;
    font-weight: 500;
  }
  .prose-content :global(code) {
    font-family: var(--font-sans);
    font-size: 0.875em;
  }
</style>
