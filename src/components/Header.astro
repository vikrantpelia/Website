---
/**
 * Site identity block: photo → name → title, stacked. Renders identically
 * on Home (where it opens the intro) and at the top of every case
 * study/article page (where the photo and name link back to Home).
 *
 * Photo and name both link home for mouse/touch, but the photo link is
 * hidden from the accessibility tree (aria-hidden + tabindex="-1") so
 * keyboard/screen-reader users don't hit two adjacent links to the same
 * destination — the name link, with its own visible text, is the one
 * real stop. Same convention as the project tiles' image/title links.
 */
---

<div class="site-id">
  <a href="/" class="site-id__photo-link tap-target" tabindex="-1" aria-hidden="true">
    <div class="site-id__photo" role="img" aria-label="Headshot placeholder"></div>
  </a>
  <a href="/" class="site-id__name tap-target">Vikrant Pelia</a>
  <p class="site-id__title">UX / UI Designer · Access Control</p>
</div>

<style>
  .site-id {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .site-id__photo-link {
    display: inline-block;
    margin-bottom: 1rem;
    border-radius: 9999px;
  }

  .site-id__photo {
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--border);
    border-radius: 9999px;
    box-shadow: var(--shadow-media-sm);
    background-color: var(--border);
    transition: opacity 150ms ease;
  }

  .site-id__name {
    display: inline-block;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    margin-bottom: 0.375rem;
  }

  .site-id__title {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 400;
    color: var(--text-muted);
  }

  @media (hover: hover) and (pointer: fine) {
    .site-id__photo-link:hover .site-id__photo {
      opacity: 0.88;
    }
    .site-id__name:hover {
      text-decoration: underline;
      text-underline-offset: 2px;
    }
  }
</style>
