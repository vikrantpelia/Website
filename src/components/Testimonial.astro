---
/**
 * Single social-proof quote for Home. Soft background-tint block (no
 * border/shadow), left-aligned: quote, then a small photo/name/title
 * attribution row. Not a carousel — this site shows exactly one testimonial.
 */
interface Props {
  quote: string;
  name: string;
  role?: string;
}

const { quote, name, role } = Astro.props;
---

<figure class="testimonial">
  <blockquote class="testimonial__quote">
    <p>{quote}</p>
  </blockquote>
  <figcaption class="testimonial__attribution">
    <div class="testimonial__photo" role="img" aria-label="Headshot placeholder"></div>
    <div>
      <p class="testimonial__name">{name}</p>
      {role && <p class="testimonial__role meta-label">{role}</p>}
    </div>
  </figcaption>
</figure>

<style>
  .testimonial {
    padding: 2.25rem 2rem;
    border-radius: var(--radius-media);
    background-color: color-mix(in oklch, var(--text) 5%, var(--bg));
    text-align: left;
  }

  .testimonial__quote {
    margin: 0 0 1.5rem;
  }

  .testimonial__quote p {
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--text);
    margin: 0;
  }

  .testimonial__attribution {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .testimonial__photo {
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--border);
    border-radius: 9999px;
    box-shadow: var(--shadow-media-sm);
    background-color: var(--border);
  }

  .testimonial__name {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
    margin: 0 0 0.125rem;
  }

  .testimonial__role {
    margin: 0;
  }
</style>
