---
interface Props {
  title: string;
  category: string;
  year: number;
  coverImage: string;
  coverAlt: string;
  href: string;
}

const { title, category, year, coverImage, coverAlt, href } = Astro.props;
---

<a href={href} class="case-study-card group block" aria-label={title}>
  <div class="card-image-wrap">
    <img
      src={coverImage}
      alt={coverAlt}
      width="800"
      height="520"
      loading="lazy"
      decoding="async"
      class="card-image"
    />
  </div>
  <div class="card-meta mt-4">
    <span class="meta-label">{category} · {year}</span>
    <h2 class="card-title mt-1">{title}</h2>
  </div>
</a>

<style>
  .case-study-card {
    text-decoration: none;
    display: block;
  }

  .card-image-wrap {
    overflow: hidden;
    border-radius: var(--radius-media);
    background-color: var(--border);
    aspect-ratio: 16 / 10;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .case-study-card:hover .card-image {
      opacity: 0.88;
    }
    .case-study-card:hover .card-title {
      text-decoration: underline;
      text-underline-offset: 2px;
    }
  }

  .card-title {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text);
    line-height: 1.3;
  }
</style>
