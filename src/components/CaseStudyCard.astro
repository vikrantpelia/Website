---
interface Props {
  title: string;
  summary: string;
  coverImage: string;
  coverAlt: string;
  href: string;
}

const { title, summary, coverImage, coverAlt, href } = Astro.props;
---

<div class="project-tile">
  <a href={href} class="project-tile__image-link" tabindex="-1" aria-hidden="true">
    <img
      src={coverImage}
      alt={coverAlt}
      width="800"
      height="520"
      loading="lazy"
      decoding="async"
      class="project-tile__image"
    />
  </a>
  <a href={href} class="project-tile__title-link">
    <h3 class="project-tile__title">{title}</h3>
  </a>
  <p class="project-tile__description">{summary}</p>
</div>

<style>
  .project-tile__image-link {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-media);
    background-color: var(--border);
    aspect-ratio: 16 / 10;
  }

  .project-tile__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .project-tile__image-link:hover .project-tile__image {
      opacity: 0.88;
    }
  }

  .project-tile__title-link {
    display: inline-block;
    text-decoration: none;
    margin-top: 1.5rem;
  }

  .project-tile__title {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text);
    line-height: 1.3;
  }

  @media (hover: hover) and (pointer: fine) {
    .project-tile__title-link:hover .project-tile__title {
      text-decoration: underline;
      text-underline-offset: 2px;
    }
  }

  .project-tile__description {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-muted);
  }
</style>
