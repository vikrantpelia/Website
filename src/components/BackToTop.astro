---
/**
 * Fixed bottom-right back-to-top button, present on every page. Fades in
 * once the page has scrolled past a threshold, fades out again near the
 * top — and also hides once the footer scrolls into view, so it never
 * sits on top of the footer's own links regardless of page length.
 */
---

<button
  type="button"
  class="back-to-top tap-target"
  data-back-to-top
  aria-label="Back to top"
  aria-hidden="true"
  tabindex="-1"
>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 19V5M5 12l7-7 7 7" />
  </svg>
</button>

<script>
  function initBackToTop() {
    const backToTop = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
    const footer = document.querySelector('footer');
    if (!backToTop) return;

    const THRESHOLD = 400;
    let pastThreshold = false;
    let footerVisible = false;
    let visible = false;
    let ticking = false;

    function update() {
      ticking = false;
      const shouldShow = pastThreshold && !footerVisible;
      if (shouldShow === visible) return;
      visible = shouldShow;
      backToTop!.classList.toggle('back-to-top--visible', visible);
      backToTop!.tabIndex = visible ? 0 : -1;
      // Keep it out of screen-reader browse-mode navigation too, not just
      // the Tab sequence — otherwise a linear reading pass still hits an
      // invisible "Back to top" button before it has ever appeared.
      backToTop!.setAttribute('aria-hidden', String(!visible));
    }

    window.addEventListener(
      'scroll',
      () => {
        pastThreshold = window.scrollY > THRESHOLD;
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true }
    );

    if (footer) {
      new IntersectionObserver(
        ([entry]) => {
          footerVisible = entry.isIntersecting;
          update();
        },
        { rootMargin: '0px' }
      ).observe(footer);
    }

    backToTop.addEventListener('click', () => {
      window.scrollTo({ top: 0, left: 0 });
      // Without this, keyboard focus stays on this button after it hides
      // itself (tabindex -1, aria-hidden) — stranding it on a removed-from-
      // the-a11y-tree element instead of moving on with the page.
      document.getElementById('main-content')?.focus();
    });

    update();
  }

  initBackToTop();
</script>

<style>
  .back-to-top {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 40;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: none;
    border-radius: 9999px;
    background-color: var(--bg);
    box-shadow: var(--shadow-raised);
    color: var(--text-muted);
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transform: translateY(6px);
    transition: opacity 200ms cubic-bezier(0.32, 0.72, 0, 1), transform 200ms cubic-bezier(0.32, 0.72, 0, 1), background-color 150ms ease, color 150ms ease;
  }

  .back-to-top--visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  @media (hover: hover) and (pointer: fine) {
    .back-to-top:hover {
      color: var(--text);
      /* Mixed against --bg (not the alpha-based --border token) so the fill
         stays opaque over whatever page content sits underneath. */
      background-color: color-mix(in oklch, var(--text) 8%, var(--bg));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition: none;
    }
  }
</style>
