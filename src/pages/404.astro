---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Page not found">
  <div class="px-6 pt-20 pb-24 md:pt-28">
    <div class="mx-auto" style="max-width: 68ch;">

      <p class="meta-label mb-8">ERROR · 404 · ACCESS DENIED</p>

      <h1 class="text-3xl md:text-4xl font-semibold leading-tight text-balance mb-6" style="color: var(--text);">
        No entry.
      </h1>

      <p class="mb-12" style="color: var(--text-muted); line-height: 1.8;">
        This credential isn't valid for the requested zone. The page may have moved or never existed.
      </p>

      <a
        href="/"
        class="meta-label hover-text-accent tap-target transition-colors"
        style="color: var(--text-muted);"
      >
        ← Return to home
      </a>

    </div>
  </div>
</BaseLayout>

<style>
  @media (hover: hover) and (pointer: fine) {
    .hover-text-accent:hover {
      color: var(--text);
      text-decoration: underline;
      text-underline-offset: 2px;
    }
  }
</style>
