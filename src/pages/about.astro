---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About"
  description="Vikrant Pelia — UX/UI designer specialising in access control software for physical security."
>
  <div class="px-6 pt-20 pb-24 md:pt-28">
    <div class="mx-auto" style="max-width: 68ch;">

      <p class="meta-label mb-8">ABOUT</p>

      <!-- Headshot placeholder -->
      <div
        class="mb-12"
        style="width: 96px; height: 96px; background-color: var(--border); border-radius: 4px;"
        role="img"
        aria-label="Headshot placeholder"
      ></div>

      <h1 class="text-3xl md:text-4xl font-semibold leading-tight text-balance mb-8" style="color: var(--text);">
        Vikrant Pelia
      </h1>

      <!-- Bio placeholder — replace with real copy -->
      <div class="prose-bio space-y-5">
        <p>
          Placeholder — add your About bio here. Talk about your background in access control UX, how you got into the physical security space, and what drives your approach.
        </p>
        <p>
          Based in [city]. Previously [company/role]. Currently [current situation].
        </p>
      </div>

      <div class="hairline mt-16 mb-10"></div>

      <nav aria-label="External links">
        <ul class="list-none m-0 p-0 space-y-4">
          <li>
            <a
              href="https://linkedin.com/in/vikrantpelia"
              class="about-link meta-label tap-target"
              target="_blank"
              rel="noopener noreferrer"
            >
              LinkedIn ↗
            </a>
          </li>
          <li>
            <a
              href="#"
              class="about-link meta-label tap-target"
              target="_blank"
              rel="noopener noreferrer"
            >
              PhySec Collective ↗
            </a>
          </li>
        </ul>
      </nav>

    </div>
  </div>
</BaseLayout>

<style>
  .prose-bio p {
    color: var(--text);
    line-height: 1.8;
  }

  .about-link {
    text-decoration: none;
    transition: color 150ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .about-link:hover {
      color: var(--accent-text);
    }
  }
</style>
