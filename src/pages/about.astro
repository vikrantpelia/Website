---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About"
  description="Vikrant Pelia — UX/UI designer specialising in access control software for physical security."
>
  <div class="px-6 pt-24 pb-28 md:pt-32 md:pb-36">
    <div class="mx-auto" style="max-width: 68ch;">

      <p class="meta-label mb-8">ABOUT</p>

      <!-- Headshot placeholder -->
      <div
        class="mb-14"
        style="width: 96px; height: 96px; background-color: var(--border); border-radius: var(--radius-media);"
        role="img"
        aria-label="Headshot placeholder"
      ></div>

      <h1 class="text-3xl md:text-4xl font-semibold leading-tight text-balance mb-8" style="color: var(--text);">
        Vikrant Pelia
      </h1>

      <!-- Bio placeholder — replace with real copy -->
      <div class="prose-bio space-y-5">
        <p>
          Placeholder — add your About bio here. Talk about your background in access control UX, how you got into the physical security space, and what drives your approach.
        </p>
        <p>
          Based in [city]. Previously [company/role]. Currently [current situation].
        </p>
      </div>

    </div>
  </div>
</BaseLayout>

<style>
  .prose-bio p {
    color: var(--text);
    line-height: 1.8;
  }
</style>
