---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import Testimonial from '../components/Testimonial.astro';
import { getCollection } from 'astro:content';

const caseStudies = (await getCollection('case-studies')).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

function readingTime(body: string): number {
  return Math.max(1, Math.ceil(body.split(/\s+/).length / 200));
}
---

<BaseLayout
  title="Vikrant Pelia"
  description="UX/UI designer specialising in access control software — making complex physical security systems usable."
>
  <div class="px-6 pt-20 pb-32 md:pt-28 md:pb-44">
    <div class="mx-auto" style="max-width: 68ch;">

      <!-- Intro: header, bio, contact -->
      <section class="mb-24 md:mb-36">
        <Header />

        <p class="intro-bio mt-10 md:mt-12">
          Operator workflows, credential management, audit interfaces, mobile access — the B2B infrastructure that keeps buildings running. I make it usable without making it soft.
        </p>

        <p id="contact" class="intro-bio mt-6">
          If you'd like to connect, get in touch via <a href="mailto:hello@vikrantpelia.com" class="intro-link">email</a>, <a href="https://x.com/vikrantpelia" class="intro-link" target="_blank" rel="noopener noreferrer">X</a>, or <a href="https://linkedin.com/in/vikrantpelia" class="intro-link" target="_blank" rel="noopener noreferrer">LinkedIn</a>.
        </p>
      </section>

      <!-- Projects -->
      <section id="projects" class="mb-24 md:mb-36">
        <p class="meta-label mb-8">Projects</p>
        <div class="project-grid">
          {caseStudies.map(cs => (
            <CaseStudyCard
              title={cs.data.title}
              summary={cs.data.summary}
              coverImage={cs.data.coverImage}
              coverAlt={cs.data.coverAlt}
              href={`/projects/${cs.id}`}
            />
          ))}
        </div>
      </section>

      <!-- Articles -->
      <section id="articles" class="mb-24 md:mb-36">
        <p class="meta-label mb-8">Articles</p>
        <ul class="list-none m-0 p-0 space-y-0">
          {posts.map((post, i) => (
            <li>
              {i > 0 && <div class="hairline"></div>}
              <a href={`/blog/${post.id}`} class="article-row block py-7">
                <span class="article-row__title block text-base font-medium">{post.data.title}</span>
                <span class="meta-label block mt-2">
                  {post.data.publishDate.toLocaleDateString('en-GB', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                  {' · '}
                  {readingTime(post.body ?? '')} min read
                </span>
                <span class="article-row__description block mt-2 text-sm">{post.data.summary}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <!-- Testimonial -->
      <section>
        <p class="meta-label mb-6" style="color: var(--accent-text);">
          Placeholder quote — replace with the real quote before launch
        </p>
        <Testimonial
          quote="Vikrant has a rare ability to make complex access-control workflows feel obvious in hindsight."
          name="Lee Odess"
          role="CEO, The Access Control Collective"
        />
      </section>

    </div>
  </div>
</BaseLayout>

<style>
  .intro-bio {
    max-width: 60ch;
    color: var(--text);
    line-height: 1.8;
  }

  .intro-link {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: opacity 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .intro-link:hover {
      opacity: 0.7;
    }
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem 1.5rem;
  }

  @media (max-width: 640px) {
    .project-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  .article-row {
    text-decoration: none;
  }

  .article-row__title {
    color: var(--text);
    transition: color 150ms ease;
  }

  .article-row__description {
    color: var(--text-muted);
    line-height: 1.6;
  }

  @media (hover: hover) and (pointer: fine) {
    .article-row:hover .article-row__title {
      text-decoration: underline;
      text-underline-offset: 2px;
    }
  }
</style>
