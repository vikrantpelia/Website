---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import Testimonial from '../components/Testimonial.astro';
import Carousel from '../components/Carousel.astro';
import { getCollection } from 'astro:content';

const allCaseStudies = await getCollection('case-studies');
const featured = allCaseStudies
  .filter(cs => cs.data.featured)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

// Real companies, placeholder logo treatment (text wordmarks) until logo
// assets are ready.
const trustedBy = ['Stanley Security', 'Securitas', 'TACC', 'IQSIGHT'];

// Placeholder quotes/attribution — swap for real testimonials before launch.
const testimonials = [
  {
    quote: "Working with Vikrant meant our operators finally stopped filing tickets for problems that were actually just confusing UI.",
    name: 'Jordan Ellis',
    role: 'Director of Operations, Placeholder Security Co.',
  },
  {
    quote: 'He has a rare ability to make complex access-control workflows feel obvious in hindsight.',
    name: 'Priya Nair',
    role: 'VP Product, Example Corp',
  },
  {
    quote: "The redesign didn't just look better — it measurably cut our onboarding time.",
    name: 'Marcus Webb',
    role: 'Head of Customer Success, Sample Industries',
  },
];
---

<BaseLayout
  title="Vikrant Pelia"
  description="UX/UI designer specialising in access control software — making complex physical security systems usable."
>
  <!-- Hero / Bio -->
  <section class="px-6 pt-24 pb-28 md:pt-36 md:pb-40">
    <div class="mx-auto" style="max-width: 68ch;">
      <p class="meta-label mb-6">UX / UI DESIGN · ACCESS CONTROL</p>
      <h1 class="text-3xl md:text-4xl font-semibold leading-tight text-balance mb-6" style="color: var(--text);">
        I design software for physical access control — the systems that decide who goes where.
      </h1>
      <p class="text-base" style="color: var(--text-muted); line-height: 1.8;">
        Operator workflows, credential management, audit interfaces, mobile access — the B2B infrastructure that keeps buildings running. I make it usable without making it soft.
      </p>
    </div>
  </section>

  <!-- Logo trust bar -->
  <section class="px-6 pb-28 md:pb-40">
    <div class="mx-auto" style="max-width: 68ch;">
      <ul class="logo-strip">
        {trustedBy.map(name => (
          <li class="logo-strip__item">{name}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Featured case studies -->
  <section class="px-6 pb-32 md:pb-44" aria-labelledby="work-heading">
    <div class="mx-auto" style="max-width: 68ch;">
      <div class="mb-14 flex items-center justify-between">
        <h2 id="work-heading" class="meta-label">SELECTED WORK</h2>
        <a href="/projects" class="meta-label all-projects-link tap-target" style="color: var(--text-muted);">
          All projects →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 md:gap-x-10 gap-y-16 md:gap-y-20">
        {featured.map(cs => (
          <CaseStudyCard
            title={cs.data.title}
            category={cs.data.category}
            year={cs.data.year}
            coverImage={cs.data.coverImage}
            coverAlt={cs.data.coverAlt}
            href={`/projects/${cs.id}`}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="px-6 pb-24 md:pb-32" aria-labelledby="testimonials-heading">
    <div class="mx-auto" style="max-width: 68ch;">
      <h2 id="testimonials-heading" class="meta-label mb-3">Testimonials</h2>
      <p class="meta-label mb-12" style="color: var(--accent-text);">
        Placeholder quotes — replace with real testimonials before launch
      </p>

      <Carousel
        ariaLabel="Client and colleague testimonials"
        captions={testimonials.map(t => t.name)}
        unitLabel="Testimonial"
        showCaption={false}
        frame={false}
      >
        {testimonials.map(t => (
          <Testimonial quote={t.quote} name={t.name} role={t.role} />
        ))}
      </Carousel>
    </div>
  </section>
</BaseLayout>

<style>
  .logo-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem 2.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .logo-strip__item {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  .all-projects-link {
    text-decoration: none;
    transition: color 150ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .all-projects-link:hover {
      color: var(--text);
      text-decoration: underline;
      text-underline-offset: 2px;
    }
  }
</style>
